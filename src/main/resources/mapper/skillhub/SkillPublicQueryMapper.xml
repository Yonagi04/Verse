<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yonagi.verse.dao.mapper.skillhub.SkillPublicQueryMapper">
    <resultMap id="publicView" type="com.yonagi.verse.dao.projection.SkillPublicProjection">
        <id column="skill_id" property="skillId"/>
        <result column="publisher_id" property="publisherId"/>
        <result column="handle" property="handle"/>
        <result column="public_name" property="publicName"/>
        <result column="slug" property="slug"/>
        <result column="name" property="name"/>
        <result column="summary" property="summary"/>
        <result column="category_id" property="categoryId"/>
        <result column="revision_id" property="revisionId"/>
        <result column="version_id" property="versionId"/>
        <result column="version_label" property="versionLabel"/>
        <result column="published_at" property="publishedAt"/>
        <result column="skill_markdown" property="skillMarkdown"/>
        <result column="declarations_json" property="declarationsJson"/>
        <result column="archive_bytes" property="archiveBytes"/>
        <result column="archive_sha256" property="archiveSha256"/>
    </resultMap>
    <resultMap id="revisionTag" type="com.yonagi.verse.dao.projection.SkillRevisionTagProjection">
        <result column="revision_id" property="revisionId"/>
        <result column="tag_id" property="tagId"/>
    </resultMap>
    <resultMap id="option" type="com.yonagi.verse.dao.projection.SkillOptionProjection">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
    </resultMap>
    <sql id="authorName">COALESCE(NULLIF(TRIM(u.nickname),''),u.username)</sql>
    <sql id="cardColumns">
        s.skill_id,s.publisher_id,p.handle,<include refid="authorName"/> AS public_name,
        s.slug,r.name,r.summary,r.category_id,
        r.revision_id,v.version_id,v.version_label,v.published_at
    </sql>
    <sql id="publishedJoins">
        FROM t_skill s
        JOIN t_skill_publisher p ON p.publisher_id=s.publisher_id
        JOIN t_user u ON u.user_id=p.user_id
        JOIN t_skill_revision r ON r.revision_id=s.public_revision_id AND r.skill_id=s.skill_id
        JOIN t_skill_version v ON v.version_id=s.current_version_id AND v.skill_id=s.skill_id
    </sql>
    <sql id="availableJoins">
        <include refid="publishedJoins"/>
        JOIN t_skill_artifact a ON a.artifact_id=v.artifact_id
    </sql>
    <sql id="accountAvailable">
        p.status='ACTIVE' AND u.status=1 AND u.del_flag=0
    </sql>
    <sql id="available">
        s.status='ACTIVE' AND v.status='AVAILABLE' AND a.status='READY'
        AND <include refid="accountAvailable"/>
    </sql>
    <sql id="filters">
        <if test="query.keyword != null">
            AND (r.name LIKE #{query.contains} ESCAPE '!'
                 OR <include refid="authorName"/> LIKE #{query.contains} ESCAPE '!'
                 OR u.username LIKE #{query.contains} ESCAPE '!')
        </if>
        <if test="query.category != null">AND r.category_id=#{query.category}</if>
        <if test="query.publisherId != null">AND p.publisher_id=#{query.publisherId}</if>
        <if test="query.tags != null and !query.tags.isEmpty()">
            AND EXISTS (SELECT rt.revision_id FROM t_skill_revision_tag rt
                        WHERE rt.revision_id=r.revision_id AND rt.tag_id IN
                        <foreach collection="query.tags" item="tag" open="(" separator="," close=")">
                            #{tag}
                        </foreach>)
        </if>
    </sql>
    <select id="countAvailable" resultType="long">
        SELECT COUNT(*) <include refid="availableJoins"/>
        WHERE <include refid="available"/> <include refid="filters"/>
    </select>
    <select id="selectAvailablePage" resultMap="publicView">
        SELECT <include refid="cardColumns"/> <include refid="availableJoins"/>
        WHERE <include refid="available"/> <include refid="filters"/>
        ORDER BY
        <if test="query.relevance and query.keyword != null">
            CASE WHEN r.name=#{query.exact} OR <include refid="authorName"/>=#{query.exact} OR u.username=#{query.exact} THEN 0
                 WHEN r.name LIKE #{query.prefix} ESCAPE '!'
                      OR <include refid="authorName"/> LIKE #{query.prefix} ESCAPE '!'
                      OR u.username LIKE #{query.prefix} ESCAPE '!' THEN 1
                 ELSE 2 END,
        </if>
        s.latest_release_at DESC,s.skill_id DESC LIMIT #{query.size} OFFSET #{query.offset}
    </select>
    <select id="selectAvailableDetail" resultMap="publicView">
        SELECT <include refid="cardColumns"/>,a.skill_markdown,v.declarations_json,a.archive_bytes,a.archive_sha256
        <include refid="availableJoins"/>
        WHERE s.skill_id=#{skillId} AND <include refid="available"/>
    </select>
    <select id="selectPublishedPlaceholder" resultMap="publicView">
        SELECT <include refid="cardColumns"/> <include refid="publishedJoins"/>
        WHERE s.skill_id=#{skillId} AND <include refid="accountAvailable"/>
    </select>
    <select id="selectPublishedId" resultType="long">
        SELECT s.skill_id FROM t_skill s JOIN t_skill_publisher p ON p.publisher_id=s.publisher_id
        JOIN t_user u ON u.user_id=p.user_id
        WHERE p.handle=#{handle} AND s.slug=#{slug} AND s.public_revision_id IS NOT NULL
              AND s.current_version_id IS NOT NULL AND <include refid="accountAvailable"/>
    </select>
    <select id="selectRevisionTags" resultMap="revisionTag">
        SELECT revision_id,tag_id FROM t_skill_revision_tag WHERE revision_id IN
        <foreach collection="revisionIds" item="revision" open="(" separator="," close=")">#{revision}</foreach>
        ORDER BY revision_id,tag_id
    </select>
    <select id="selectCategories" resultMap="option">
        SELECT category_id AS id,name FROM t_skill_category WHERE enabled=1 ORDER BY sort_order,category_id
    </select>
    <select id="selectTags" resultMap="option">
        SELECT tag_id AS id,name FROM t_skill_tag WHERE enabled=1 ORDER BY sort_order,tag_id
    </select>
</mapper>
